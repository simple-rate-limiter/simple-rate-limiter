PG_CONTAINER_NAME="rate_limiter_pg"  # Default container name
PG_HOST="127.0.0.1" # Host for PostgreSQL to run on
PG_PORT="5432"  # Port for PostgreSQL to listen on
PG_USER="rate_limiter"  # PostgreSQL user name
PG_PASSWORD="rate_limiter"  # Password for the PostgreSQL user
DB_NAME="rate_limiter"  # Name of the database to create